# Producción: copiar como .env SOLO en una instalación nueva.
# En una actualización, editar el .env existente; conservar sus secretos.
WEB_BIND_IP=10.10.10.13
WEB_PORT=80
# LAB-DB-POSTGRES: motores nativos, no contenedores de esta plataforma.
# Ajustar nombres/cuentas a los entregados por el administrador de BD.
# Las claves dentro de estas URLs deben estar codificadas para URL.
# PostgreSQL: TLS cifrado; ssl=require NO verifica identidad del servidor.
# Para CA verificada, consultar README-SETUP.md antes de usar verify-full.
DATABASE_URL='postgresql+asyncpg://cociber_app:CHANGE_ME_PG_URL_ENCODED@10.10.10.14:5432/cociber_ctf?ssl=require'
# Redis 7 con usuario ACL de aplicación; contraseña independiente de PostgreSQL.
REDIS_URL='redis://cociber_app:CHANGE_ME_REDIS_URL_ENCODED@10.10.10.14:6379/0'
MANAGE_SCHEMA_ON_STARTUP=false
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
FIELD_HMAC_SECRET=CHANGE_ME_LONG_RANDOM_HMAC_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=20
# Sesión única por cuenta: habilitar tras comprobar el cierre de sesión y Redis.
SINGLE_SESSION_ENABLED=false
REFRESH_TOKEN_DAYS=7
CTF_DEMO_PASSWORD=LabDemo-ChangeMe-2026!
CTF_SEED_DEMO_DATA=false
# Integración existente de Guacamole: valores conservados, BD independiente.
# Al migrar, mantener las líneas GUACAMOLE_* de su .env privado operativo.
# Ejemplo LAB-GUAC: API por red administrativa, portal por red CTF.
# No cambiar un .env operativo sin verificar conectividad y puertos.
GUACAMOLE_MODE=real
GUACAMOLE_BASE_URL=http://10.195.20.22:8080/guacamole
GUACAMOLE_API_URL=http://10.10.10.10:8080/guacamole
GUACAMOLE_SERVICE_ACCOUNT=ctf_guac_service
GUACAMOLE_SERVICE_PASSWORD=CHANGE_ME_PRIVATE_SECRET
PUBLIC_ORIGIN=http://10.10.10.13

# ------------------------------------------------------------
# Fase A — inyector SSH de banderas dinámicas
# Por seguridad permanece deshabilitado hasta configurar el laboratorio.
# ------------------------------------------------------------
FLAG_INJECTOR_ENABLED=false
FLAG_INJECTOR_SSH_USER=ctf-injector
FLAG_INJECTOR_SSH_PASSWORD=
# Rutas dentro del contenedor API; se montan con el overlay lab-secrets.
FLAG_INJECTOR_SSH_PRIVATE_KEY=/run/secrets/lnxvict_lab_ssh_key
FLAG_INJECTOR_KNOWN_HOSTS=/run/secrets/lnxvict_lab_known_hosts
# Rutas privadas del host LAB-CTFWEB. Se usan solo con el overlay opt-in.
FLAG_INJECTOR_SSH_PRIVATE_KEY_HOST=
FLAG_INJECTOR_KNOWN_HOSTS_HOST=
FLAG_INJECTOR_SSH_PORT=22
FLAG_INJECTOR_CONNECT_TIMEOUT=10
FLAG_INJECTOR_COMMAND_TIMEOUT=15
FLAG_INJECTOR_STRICT_HOST_KEY=true
FLAG_INJECTOR_REMOTE_SCRIPT=/usr/local/sbin/ctf-inject-flag.sh
FLAG_INJECTOR_FLAG_PATH=/opt/ctf/flag.txt
FLAG_INJECTOR_LOCK_TTL_SECONDS=5400

# DVWA (opt-in): rutas deben montarse en el contenedor API solo lectura.
DVWA_LAB_ENABLED=false
DVWA_LAB_SSH_USER=labops
DVWA_LAB_SSH_PRIVATE_KEY=/run/secrets/dvwa_lab_ssh_key
DVWA_LAB_KNOWN_HOSTS=/run/secrets/dvwa_lab_known_hosts
DVWA_LAB_SSH_PRIVATE_KEY_HOST=
DVWA_LAB_KNOWN_HOSTS_HOST=
