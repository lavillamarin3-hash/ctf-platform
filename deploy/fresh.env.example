# Copiar a .env.fresh. Plantilla EXCLUSIVA para instalación nueva.
# No sustituir el .env histórico. Generar cada secreto por separado.
# Compose: --env-file .env.fresh -f deploy/docker-compose.fresh.yml
WEB_BIND_IP=10.10.10.13
WEB_PORT=8081
# Confirmar terminación TLS/DNAT antes de usar esta URL; la app no cambia la red.
PUBLIC_ORIGIN=https://10.195.20.21
# Base VACÍA independiente de la instalación anterior. Usuario con permisos
# de esquema solo durante init-db; usar una cuenta de aplicación después.
DATABASE_URL=postgresql+asyncpg://cociber_app:CHANGE_ME@10.10.10.14:5432/cociber_fresh
REDIS_URL=redis://cociber_app:CHANGE_ME@10.10.10.14:6379/1
# openssl rand -hex 32 (64 caracteres). También cifra tokens Guacamole en Redis.
JWT_SECRET=
JWT_EXPIRA_MINUTOS=60
BOOTSTRAP_ADMIN=false
ADMIN_CTF_USERNAME=admin_ctf
ADMIN_CTF_PASSWORD=
# API interna; .22 es interfaz de gestión de LAB-GUAC, no alias de LAB-RTRFW.
# El jugador usa el túnel del mismo origen CTF; no requiere acceder a .22.
GUACAMOLE_API_URL=http://10.10.10.10:8080/guacamole
GUACAMOLE_ADMIN_USER=
GUACAMOLE_ADMIN_PASSWORD=
GUACAMOLE_DATASOURCE=mysql
# Instalar/probar helpers nuevos ANTES de activar. Puerto administrativo 22.
SSH_INJECTOR_ENABLED=false
SSH_INJECTOR_USER=labops
SSH_INJECTOR_KEY_PATH=/run/secrets/labops_ed25519
SSH_INJECTOR_KNOWN_HOSTS=/run/secrets/known_hosts
DVWA_LAB_ENABLED=false
# Interfaz reservada; ESC-04 permanece deshabilitado, aun con esta variable.
WINRM_INJECTOR_ENABLED=false
WINRM_SERVICE_USER=labops
WINRM_SERVICE_PASSWORD=
TTL_CORRIDA_BASICO_MIN=30
TTL_CORRIDA_MEDIO_MIN=45
TTL_CORRIDA_AVANZADO_MIN=60
# No hay MANAGE_SCHEMA_ON_STARTUP ni CTF_SEED_DEMO_DATA en la versión nueva:
# el esquema se crea solo con init-db, y el catálogo se carga explícitamente.
# Cupo efectivo: 1 por Kali (índice único); no se promete un cupo de seis.
