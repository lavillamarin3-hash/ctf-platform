[Unit]
Description=CoCiber CTF · despliegue seguro y automatico de main
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/cociber-ctf/auto-deploy.conf
ExecStart=/usr/local/sbin/cociber-auto-deploy-main --once
WorkingDirectory=/
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
