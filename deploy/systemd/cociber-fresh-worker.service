[Unit]
Description=CoCiber cola y limpieza (instalacion nueva)
After=docker.service network-online.target
Requires=docker.service
[Service]
Type=simple
# Ajustar WorkingDirectory al clon real; no instalar esta unidad sin revisarlo.
WorkingDirectory=/home/lab-ctfweb/ctf-platform
ExecStart=/usr/bin/docker compose --env-file .env.fresh -f deploy/docker-compose.fresh.yml run --rm --no-deps --name cociber-fresh-worker api python -m ctf.infrastructure.worker
ExecStop=/usr/bin/docker stop --time 60 cociber-fresh-worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
[Install]
WantedBy=multi-user.target
